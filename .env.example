# Public URL of the deployed site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where contact-form inquiries are delivered (server-side only).
# Any endpoint that accepts a JSON POST: Formspree, Zapier/Make webhook,
# a CRM intake URL, or your own API. Leave unset and the form tells
# visitors that online sending is not connected and offers email/WhatsApp.
INQUIRY_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <secret>" with each inquiry.
INQUIRY_WEBHOOK_SECRET=
